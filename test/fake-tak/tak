#!/usr/bin/env bash
# A stand-in for tak in the classifier tests: `tak compare` prints a canned
# report and stderr and exits with a canned status, so the action's
# classification can be tested against output real tak would only produce
# with hostile input. Everything else is refused.
set -euo pipefail
dir="${RUNNER_TEMP:?}/fake-tak"
case "${1:-}" in
  --version) echo "tak 0.0.0-fake" ;;
  # Lists allow_empty, as tak releases with that setting do, only when the
  # case says this stand-in is one of them; fails when the case says so.
  settings)
    if [ -e "$dir/settings-fails" ]; then
      echo "Error: settings probe failed on purpose" >&2
      exit 3
    fi
    echo "env_allow  list<string>"
    if [ -e "$dir/allow-empty-setting" ]; then
      echo "allow_empty  bool"
    fi
    ;;
  compare)
    cat "$dir/report"
    cat "$dir/stderr" >&2
    exit "$(cat "$dir/exit")"
    ;;
  *)
    echo "fake tak: unsupported command: $*" >&2
    exit 2
    ;;
esac
